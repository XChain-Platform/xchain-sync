# sync.xchain.io - bootstrap "latest" alias
#
# Deploy to:  /var/www/virtual/sync.xchain.io/bootstraps/.htaccess
#
# A request for any   <service>/<coin>/<network>/latest.tgz
# is resolved by latest.php to a 302 redirect at the newest published
# <network>-<service>-<YYYYMMDD_HHMMSS>.tar.gz in that directory.
# Just drop new archives into the directory - no symlink/cron needed.
#
# Requires: mod_rewrite + PHP enabled for this vhost, and the vhost <Directory>
# must set "AllowOverride FileInfo" (or All). FollowSymLinks is inherited from
# the vhost, so this file needs no Options override.

RewriteEngine On
RewriteBase /bootstraps/

# Resolve latest.tgz only when a real file by that name isn't present
# (so a manually-dropped real latest.tgz would still win).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/latest\.tgz$ latest.php?dir=$1&type=tgz [L,QSA]

# NOTE: there is deliberately no latest.tgz.sha256 rewrite. BootstrapService
# embeds the checksum inside the signature-verified archive (data.sha256); no
# external <archive>.sha256 sidecar is ever published, so that route would be a
# permanent 404. The detached .sig below is the sole published integrity anchor.

# Detached Ed25519 signature for the SAME newest archive (xchain-node verifies
# this against the pinned public key). Resolved alongside latest.tgz so the
# archive and its signature can never drift to different versions.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/latest\.tgz\.sig$ latest.php?dir=$1&type=sig [L,QSA]
