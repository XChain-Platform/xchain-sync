{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "mocha",
  "plugins": [
    "@stryker-mutator/mocha-runner"
  ],
  "mutate": [
    "src/client/applier.js",
    "src/client/hash_verifier.js",
    "src/util/validation.js",
    "src/server/poller.js",
    "src/client/rollback.js",
    "src/server/transparency_log.js"
  ],
  "coverageAnalysis": "perTest",
  "mochaOptions": {
    "spec": [
      "test/unit/**/*.test.js"
    ],
    "ignore": [
      "test/unit/rollback_coverage.test.js"
    ]
  },
  "reporters": [
    "html",
    "clear-text",
    "json",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation-report.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation-report.json"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 75
  },
  "incremental": true,
  "incrementalFile": "reports/mutation/.stryker-incremental.json",
  "concurrency": 4,
  "timeoutMS": 10000,
  "timeoutFactor": 1.5,
  "logLevel": "info",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "ignoreStatic": true,
  "mutator": {
    "excludedMutations": [
      "StringLiteral"
    ]
  }
}
