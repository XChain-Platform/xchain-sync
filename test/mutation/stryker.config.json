{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "mocha",
  "plugins": [
    "@stryker-mutator/mocha-runner"
  ],
  "mutate": [
    "src/**/*.js",
    "!src/api.js"
  ],
  "coverageAnalysis": "perTest",
  "mochaOptions": {
    "require": [
      "./test/setup/index.js"
    ],
    "spec": [
      "test/unit/**/*.test.js"
    ],
    "ignore": [
      "test/unit/rollback_coverage.test.js"
    ]
  },
  "reporters": [
    "html",
    "clear-text",
    "json",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "tmp/mutation/mutation-report.html"
  },
  "jsonReporter": {
    "fileName": "tmp/mutation/mutation-report.json"
  },
  "thresholds": {
    "high": 95,
    "low": 85,
    "break": 80
  },
  "incremental": true,
  "incrementalFile": "tmp/mutation/.stryker-incremental.json",
  "concurrency": 4,
  "timeoutMS": 10000,
  "timeoutFactor": 1.5,
  "logLevel": "info",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "ignoreStatic": true,
  "mutator": {
    "excludedMutations": [
      "StringLiteral"
    ]
  }
}
