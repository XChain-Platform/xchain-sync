{
  "name": "xchain-sync",
  "description": "Database replication service for the XChain Platform — syncs indexer and decoder databases to validators and consumers via REST snapshots and WebSocket streaming",
  "version": "1.7.1",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/XChain-Platform/xchain-sync.git"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "mariadb": "3.5.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/mocha-runner": "^8.7.1",
    "c8": "^11.0.0",
    "chai": "^4.5.0",
    "fast-check": "^4.6.0",
    "mocha": "^11.7.5",
    "proxyquire": "^2.1.3",
    "sinon": "^21.0.3"
  },
  "scripts": {
    "api": "node ./src/api.js",
    "test": "mocha --timeout 5000 --recursive 'test/unit/**/*.test.js'",
    "ci": "mocha --timeout 10000 --recursive 'test/unit/**/*.test.js' --exit",
    "coverage": "c8 --reporter=text --reporter=html --include 'src/**/*.js' mocha --timeout 10000 --recursive 'test/unit/**/*.test.js' --exit",
    "test:smoke": "mocha --timeout 15000 --recursive 'test/smoke/**/*.test.js'",
    "test:integration": "mocha --timeout 30000 --recursive 'test/integration/**/*.test.js'",
    "test:e2e": "mocha --timeout 120000 --slow 30000 --recursive 'test/e2e/**/*.test.js'",
    "test:regression": "mocha --timeout 10000 --exit --grep @regression --recursive 'test/unit/**/*.test.js'",
    "test:fuzz": "mocha --timeout 0 --recursive 'test/fuzz/suites/**/*.fuzz.js'",
    "test:fuzz:tier1": "mocha --timeout 0 --recursive 'test/fuzz/suites/tier1-*.fuzz.js'",
    "test:fuzz:tier2": "mocha --timeout 0 --recursive 'test/fuzz/suites/tier2-*.fuzz.js'",
    "test:fuzz:tier3": "mocha --timeout 0 --recursive 'test/fuzz/suites/tier3-*.fuzz.js'",
    "test:fuzz:quick": "FUZZ_RUNS=100 mocha --timeout 60000 --recursive 'test/fuzz/suites/**/*.fuzz.js'",
    "test:security": "mocha --timeout 5000 --recursive 'test/security/**/*.test.js'",
    "test:perf": "mocha --timeout 0 --slow 10000 --recursive 'test/perf/scenarios/**/*.test.js'",
    "test:perf:quick": "PERF_BLOCK_COUNT=50 mocha --timeout 300000 --slow 10000 --recursive 'test/perf/scenarios/**/*.test.js'",
    "test:chaos": "mocha --timeout 240000 --recursive 'test/chaos/**/*.test.js'",
    "test:mutate": "npx stryker run test/mutation/stryker.config.json",
    "test:mutate:quick": "npx stryker run test/mutation/stryker.quick.config.json",
    "test:mutate:check": "npx stryker run test/mutation/stryker.config.json --incremental"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3",
    "tmp": "^0.2.7",
    "fast-uri": "^3.1.2",
    "ajv": "^8.18.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
