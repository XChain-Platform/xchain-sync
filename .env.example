# xchain-sync configuration. Copy to .env and fill in values.
# Database replication service: syncs indexer + decoder DBs to validators via
# REST snapshots and WebSocket streaming. Runs as a server (snapshot source) or
# a client (replica), selected by SYNC_MODE.

# Required: role of this instance. Use "server" (serves snapshots) or "client"
# (pulls and applies snapshots into a replica DB).
SYNC_MODE=server

# Optional: REST/WS API port (default 3006).
SYNC_API_PORT=3006

# Strongly recommended: API key protecting all REST/WS endpoints. When set,
# requests are rejected (401) unless the caller presents it as
# "Authorization: Bearer <key>". When left empty the API is OPEN (a warning is
# logged at startup) and the destructive /halt/clear admin route is disabled
# entirely. ALWAYS set a strong value for any shared or public-facing
# deployment.
SYNC_API_KEY=your-key-here

# --- Hub coordination ---------------------------------------------------------

# Optional: comma-separated validator hub list for quorum-aware sync.
# HUB_VALIDATORS=
# Optional: single hub host/port fallback when HUB_VALIDATORS is unset.
HUB_API_HOST=127.0.0.1
HUB_PORT=10000
# Optional: hub transport (http by default, or https).
# HUB_PROTOCOL=http
# Optional: max time to wait on the hub before proceeding, in ms (default 300000).
# MAX_HUB_WAIT_MS=300000

# --- Client mode: replica DB --------------------------------------------------
# Required in client mode: the local replica MariaDB that snapshots are applied to.
REPLICA_DB_HOST=127.0.0.1
REPLICA_DB_PORT=3306
REPLICA_DB_USER=xchain
REPLICA_DB_PASS=your-db-password-here

# Optional: comma-separated snapshot source endpoints (client mode).
# SYNC_SOURCES=
# Optional: verify content hashes on applied snapshots (default true).
# VERIFY_HASHES=true
# Optional: stable identifier for this validator (default: OS hostname).
# VALIDATOR_ID=

# --- Tuning (optional; defaults shown) ----------------------------------------
# CORS_ORIGIN=                       # false (disabled) unless set
# BLOCK_POLL_INTERVAL=3000           # ms
# SNAPSHOT_RATE_FULL=12              # full snapshots per window
# SNAPSHOT_RATE_INCR=600             # incremental snapshots per window
# WS_MAX_PER_IP=100
# WS_MAX_PAYLOAD=1048576             # bytes
# WS_BACKPRESSURE_MAX_BYTES=16777216  # bytes (16 MiB): per-peer send-buffer ceiling
# WS_BACKPRESSURE_STALL_MS=30000      # ms the send buffer may go non-draining before drop
# (WS_BACKPRESSURE_LIMIT is retired; the broadcaster now drops only stalled/unbounded peers)
# SNAPSHOT_MAX_CONTENT=536870912     # bytes (512 MiB)
# MERKLE_EPOCH_SIZE=100
# TRANSPARENCY_RATE_LIMIT=10
# MAX_ROLLBACK_DEPTH=100
# HASH_CONFIRM_STRICT=false
# VALIDATOR_HEARTBEAT_TTL=60000      # ms (entries past this become 'stale', kept visible)
# EXPECTED_VALIDATORS=               # comma-separated validator ids; /validator-status
#                                    # then reports expected_total and flags never-seen
#                                    # roster members as 'absent' (default: no roster)
# TRUST_PROXY=false                  # set true only behind a trusted reverse proxy
# Pools are sized per dbType (one pool per chain x dbType pair). The indexer
# pool absorbs the poller's ~113-query-per-block fan-out plus snapshot streams;
# the decoder pool replicates 8 narrow tables. DB_POOL_SIZE still works as a
# flat override for both. Values are clamped to [2, 100].
# DB_POOL_SIZE_INDEXER=12            # connections per indexer pool
# DB_POOL_SIZE_DECODER=6             # connections per decoder pool
# DB_POOL_SIZE=                      # legacy flat override for every dbType
# DB_QUERY_TIMEOUT=30000             # ms (also DB_QUERY_TIMEOUT_INDEXER / _DECODER)
# HUB_REPOLL_INTERVAL=300000         # ms (hub config re-poll)
# WS_STATUS_INTERVAL=60000           # ms (WebSocket status broadcast)
# WS_PING_INTERVAL=30000             # ms (WebSocket keepalive ping)
# CLIENT_RECONNECT_DELAY=5000        # ms (client-mode reconnect backoff)
# HASH_CONFIRM_TIMEOUT=5000          # ms (cross-source hash confirmation)
